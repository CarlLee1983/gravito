{
  "name": "@gravito/satellite-sqlite",
  "version": "1.0.0",
  "description": "SQLite FFI binding via Xenon - Safe native database access",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:dts": "bun run build.ts --dts-only",
    "test": "bun test --timeout=10000",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck"
  },
  "dependencies": {},
  "peerDependencies": {
    "@gravito/xenon": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@gravito/xenon": {
      "optional": true
    }
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "bun-types": "latest"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gravito",
    "satellite",
    "sqlite",
    "ffi",
    "database"
  ],
  "author": "Gravito Team",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "satellites/sqlite"
  }
}

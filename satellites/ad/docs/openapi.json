{
  "openapi": "3.0.3",
  "info": {
    "title": "Advertisement Management API",
    "description": "RESTful API for managing advertisements across multiple slots. Supports CRUD operations for admins and delivery queries for public consumers.",
    "version": "1.0.0",
    "contact": {
      "name": "Gravito Team",
      "url": "https://github.com/gravito-core"
    },
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development server"
    },
    {
      "url": "https://api.example.com",
      "description": "Production server"
    }
  ],
  "tags": [
    {
      "name": "Admin",
      "description": "Administrative endpoints for managing advertisements"
    },
    {
      "name": "Public",
      "description": "Public endpoints for delivering advertisements to consumers"
    }
  ],
  "paths": {
    "/api/admin/v1/ads": {
      "post": {
        "tags": ["Admin"],
        "summary": "Create a new advertisement",
        "operationId": "createAd",
        "description": "Create a new advertisement for a specific slot. Advertisement starts in DRAFT status by default.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateAdRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Basic advertisement creation",
                  "value": {
                    "slotSlug": "homepage-banner",
                    "title": "Summer Sale",
                    "imageUrl": "https://cdn.example.com/banner.jpg",
                    "targetUrl": "https://example.com/summer-sale",
                    "weight": 50,
                    "startsAt": "2026-03-01T00:00:00Z",
                    "endsAt": "2026-03-31T23:59:59Z"
                  }
                },
                "withMetadata": {
                  "summary": "Advertisement with metadata",
                  "value": {
                    "slotSlug": "sidebar",
                    "title": "Product Launch",
                    "imageUrl": "https://cdn.example.com/product.jpg",
                    "targetUrl": "https://example.com/product",
                    "weight": 75,
                    "startsAt": "2026-03-05T08:00:00Z",
                    "endsAt": "2026-03-20T20:00:00Z",
                    "activateImmediately": true,
                    "metadata": {
                      "campaign_id": "CAMP001",
                      "utm_source": "internal"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Advertisement created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                },
                "examples": {
                  "success": {
                    "value": {
                      "success": true,
                      "data": {
                        "id": "ad-uuid-1234",
                        "slotSlug": "homepage-banner",
                        "title": "Summer Sale",
                        "imageUrl": "https://cdn.example.com/banner.jpg",
                        "targetUrl": "https://example.com/summer-sale",
                        "weight": 50,
                        "status": "DRAFT",
                        "startsAt": "2026-03-01T00:00:00Z",
                        "endsAt": "2026-03-31T23:59:59Z",
                        "createdAt": "2026-03-01T10:30:00Z",
                        "updatedAt": "2026-03-01T10:30:00Z"
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "500": {
            "$ref": "#/components/responses/InternalServerError"
          }
        }
      },
      "get": {
        "tags": ["Admin"],
        "summary": "List advertisements",
        "operationId": "listAds",
        "description": "Retrieve a paginated list of advertisements with optional filtering by status, slot, or date range.",
        "parameters": [
          {
            "name": "slotSlug",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by slot slug (e.g., 'homepage-banner')"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["DRAFT", "ACTIVE", "PAUSED", "ARCHIVED"]
            },
            "description": "Filter by advertisement status"
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1
            },
            "description": "Page number for pagination"
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "description": "Number of items per page"
          }
        ],
        "responses": {
          "200": {
            "description": "List of advertisements retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/AdDTO"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/PaginationMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/admin/v1/ads/{id}": {
      "get": {
        "tags": ["Admin"],
        "summary": "Get a specific advertisement",
        "operationId": "getAd",
        "description": "Retrieve detailed information about a specific advertisement by ID.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Advertisement ID (UUID)"
          }
        ],
        "responses": {
          "200": {
            "description": "Advertisement retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/AdNotFoundError"
          }
        }
      },
      "put": {
        "tags": ["Admin"],
        "summary": "Update an advertisement",
        "operationId": "updateAd",
        "description": "Update existing advertisement. Only DRAFT and ACTIVE status ads can be updated. Dates must be valid (start < end, both in future).",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Advertisement ID (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateAdRequest"
              },
              "examples": {
                "updateTitle": {
                  "summary": "Update title only",
                  "value": {
                    "title": "Summer Sale 2026"
                  }
                },
                "updateDates": {
                  "summary": "Update schedule dates",
                  "value": {
                    "startsAt": "2026-03-10T00:00:00Z",
                    "endsAt": "2026-03-20T23:59:59Z"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advertisement updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/AdNotFoundError"
          }
        }
      },
      "delete": {
        "tags": ["Admin"],
        "summary": "Delete an advertisement",
        "operationId": "deleteAd",
        "description": "Permanently delete an advertisement. Only DRAFT status ads can be deleted.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Advertisement ID (UUID)"
          }
        ],
        "responses": {
          "200": {
            "description": "Advertisement deleted successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "message": {
                          "type": "string",
                          "example": "Advertisement deleted successfully"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/AdNotFoundError"
          }
        }
      }
    },
    "/api/admin/v1/ads/{id}/status": {
      "patch": {
        "tags": ["Admin"],
        "summary": "Toggle advertisement status",
        "operationId": "toggleAdStatus",
        "description": "Change advertisement status. Valid transitions: DRAFT→ACTIVE, ACTIVE↔PAUSED, (any)→ARCHIVED.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Advertisement ID (UUID)"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ToggleStatusRequest"
              },
              "examples": {
                "activate": {
                  "summary": "Activate advertisement",
                  "value": {
                    "action": "activate"
                  }
                },
                "pause": {
                  "summary": "Pause advertisement",
                  "value": {
                    "action": "pause"
                  }
                },
                "resume": {
                  "summary": "Resume advertisement",
                  "value": {
                    "action": "resume"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advertisement status updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SuccessResponse"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          },
          "404": {
            "$ref": "#/components/responses/AdNotFoundError"
          }
        }
      }
    },
    "/api/v1/ads/delivery": {
      "post": {
        "tags": ["Public"],
        "summary": "Deliver advertisements via POST",
        "operationId": "deliveryPostAds",
        "description": "Request advertisements for multiple slots. Returns weighted random selection of ACTIVE, non-expired ads based on weight and delivery count.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeliveryPostRequest"
              },
              "examples": {
                "basic": {
                  "summary": "Request ads for single slot",
                  "value": {
                    "slots": ["homepage-banner"]
                  }
                },
                "multiple": {
                  "summary": "Request ads for multiple slots",
                  "value": {
                    "slots": ["homepage-banner", "sidebar", "footer"]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Advertisements delivered successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "type": "object",
                      "additionalProperties": {
                        "$ref": "#/components/schemas/DeliveredAd"
                      },
                      "example": {
                        "homepage-banner": {
                          "id": "ad-uuid-1234",
                          "title": "Summer Sale",
                          "imageUrl": "https://cdn.example.com/banner.jpg",
                          "targetUrl": "https://example.com/summer-sale"
                        },
                        "sidebar": {
                          "id": "ad-uuid-5678",
                          "title": "Product Launch",
                          "imageUrl": "https://cdn.example.com/product.jpg",
                          "targetUrl": "https://example.com/product"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/v1/ads/slots/{slotSlug}": {
      "get": {
        "tags": ["Public"],
        "summary": "Get advertisement for a slot",
        "operationId": "getAdBySlot",
        "description": "Retrieve a single advertisement for a specific slot using weighted random selection.",
        "parameters": [
          {
            "name": "slotSlug",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "Slot identifier (e.g., 'homepage-banner')"
          }
        ],
        "responses": {
          "200": {
            "description": "Advertisement retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean",
                      "example": true
                    },
                    "data": {
                      "$ref": "#/components/schemas/DeliveredAd"
                    }
                  },
                  "example": {
                    "success": true,
                    "data": {
                      "id": "ad-uuid-1234",
                      "title": "Summer Sale",
                      "imageUrl": "https://cdn.example.com/banner.jpg",
                      "targetUrl": "https://example.com/summer-sale"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No advertisements found for slot",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "success": false,
                  "error": {
                    "code": "NO_ADS_FOR_SLOT",
                    "message": "No active advertisements found for slot: homepage-banner"
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AdDTO": {
        "type": "object",
        "description": "Complete advertisement data transfer object",
        "required": [
          "id",
          "slotSlug",
          "title",
          "imageUrl",
          "targetUrl",
          "weight",
          "status",
          "startsAt",
          "endsAt",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique advertisement identifier"
          },
          "slotSlug": {
            "type": "string",
            "description": "Slot identifier where ad appears"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Advertisement title/heading"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to advertisement image"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "description": "Destination URL when ad is clicked"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Weight for weighted random selection (1-100, higher = more likely)"
          },
          "status": {
            "type": "string",
            "enum": ["DRAFT", "ACTIVE", "PAUSED", "ARCHIVED"],
            "description": "Current advertisement status"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 start date and time"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 end date and time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 creation timestamp"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 last update timestamp"
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "description": "Optional custom metadata (key-value pairs)"
          }
        }
      },
      "DeliveredAd": {
        "type": "object",
        "description": "Simplified advertisement for delivery to consumers",
        "required": ["id", "title", "imageUrl", "targetUrl"],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique advertisement identifier"
          },
          "title": {
            "type": "string",
            "description": "Advertisement title"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to advertisement image"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "description": "Destination URL when ad is clicked"
          }
        }
      },
      "CreateAdRequest": {
        "type": "object",
        "required": [
          "slotSlug",
          "title",
          "imageUrl",
          "targetUrl",
          "weight",
          "startsAt",
          "endsAt"
        ],
        "properties": {
          "slotSlug": {
            "type": "string",
            "description": "Slot identifier (e.g., 'homepage-banner')"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "Advertisement title"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "URL to advertisement image"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "description": "Destination URL"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "Selection weight (higher = more likely)"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 start datetime"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "ISO 8601 end datetime"
          },
          "activateImmediately": {
            "type": "boolean",
            "default": false,
            "description": "Automatically transition to ACTIVE status"
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "description": "Custom metadata (optional)"
          }
        }
      },
      "UpdateAdRequest": {
        "type": "object",
        "minProperties": 1,
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 255,
            "description": "New advertisement title"
          },
          "imageUrl": {
            "type": "string",
            "format": "uri",
            "description": "New image URL"
          },
          "targetUrl": {
            "type": "string",
            "format": "uri",
            "description": "New destination URL"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100,
            "description": "New weight value"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "description": "New start datetime"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "description": "New end datetime"
          },
          "metadata": {
            "type": "object",
            "nullable": true,
            "description": "Updated metadata"
          }
        }
      },
      "ToggleStatusRequest": {
        "type": "object",
        "required": ["action"],
        "properties": {
          "action": {
            "type": "string",
            "enum": ["activate", "pause", "resume", "archive"],
            "description": "Status transition action"
          }
        }
      },
      "DeliveryPostRequest": {
        "type": "object",
        "required": ["slots"],
        "properties": {
          "slots": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            },
            "description": "List of slot identifiers to deliver ads for"
          }
        }
      },
      "SuccessResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "example": true
          },
          "data": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/AdDTO"
              },
              {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AdDTO"
                }
              }
            ]
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["success", "error"],
        "properties": {
          "success": {
            "type": "boolean",
            "example": false
          },
          "error": {
            "type": "object",
            "required": ["code", "message"],
            "properties": {
              "code": {
                "type": "string",
                "description": "Error code identifier"
              },
              "message": {
                "type": "string",
                "description": "Human-readable error message"
              }
            }
          }
        }
      },
      "PaginationMeta": {
        "type": "object",
        "properties": {
          "total": {
            "type": "integer",
            "description": "Total number of items"
          },
          "page": {
            "type": "integer",
            "description": "Current page number"
          },
          "limit": {
            "type": "integer",
            "description": "Items per page"
          }
        }
      }
    },
    "responses": {
      "ValidationError": {
        "description": "Input validation failed",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": {
                  "type": "boolean",
                  "example": false
                },
                "error": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "example": "VALIDATION_ERROR"
                    },
                    "message": {
                      "type": "string",
                      "example": "slotSlug: Invalid slot identifier; title: String must be 1-255 chars"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "AdNotFoundError": {
        "description": "Advertisement not found",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "AD_NOT_FOUND",
                "message": "Advertisement not found: ad-uuid-invalid"
              }
            }
          }
        }
      },
      "InternalServerError": {
        "description": "Internal server error",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ErrorResponse"
            },
            "example": {
              "success": false,
              "error": {
                "code": "INTERNAL_ERROR",
                "message": "An unexpected error occurred"
              }
            }
          }
        }
      }
    }
  }
}

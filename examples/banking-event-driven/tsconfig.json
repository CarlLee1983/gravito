{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "baseUrl": ".",
    "paths": {
      "#application/*": [
        "src/application/*"
      ],
      "#infrastructure/*": [
        "src/infrastructure/*"
      ],
      "#presentation/*": [
        "src/presentation/*"
      ],
      "#domain/*": [
        "src/domain/*"
      ]
    }
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}

{
  "name": "@examples/blog-mvc",
  "version": "0.2.4",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run dev:vite & bun run dev:server",
    "dev:server": "NODE_ENV=development PORT=${PORT:-3001} bun run --watch src/index.ts",
    "dev:vite": "vite",
    "build": "vite build",
    "typecheck": "bun vue-tsc --noEmit",
    "start": "bun run src/index.ts"
  },
  "dependencies": {
    "@gravito/atlas": "workspace:*",
    "@gravito/core": "workspace:*",
    "@gravito/ion": "workspace:*",
    "@gravito/prism": "workspace:*",
    "@gravito/pulsar": "workspace:*",
    "@gravito/sentinel": "workspace:*",
    "@gravito/signal": "workspace:*",
    "@gravito/stasis": "workspace:*",
    "@inertiajs/vue3": "^1.0.0",
    "clsx": "^2.1.0",
    "lucide-vue-next": "^0.300.0",
    "marked": "^17.0.1",
    "tailwind-merge": "^2.2.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@types/marked": "^6.0.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "autoprefixer": "^10.4.0",
    "bun-types": "latest",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vue-tsc": "^2.0.0"
  }
}
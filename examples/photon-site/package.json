{
  "name": "photon-site",
  "version": "1.2.1",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:vite & bun run dev:server",
    "dev:server": "NODE_ENV=development bun run --watch src/server/index.ts",
    "dev:vite": "vite",
    "build:client": "vite build",
    "build:static": "NODE_ENV=production bun build-static.ts",
    "build": "vite build --outDir dist/static --emptyOutDir && NODE_ENV=production bun build-static.ts",
    "preview": "bun preview.ts",
    "typecheck": "bun tsc --noEmit",
    "start": "bun run src/server/index.ts"
  },
  "dependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/freeze": "workspace:*",
    "@gravito/freeze-react": "workspace:*",
    "@gravito/ion": "workspace:*",
    "@gravito/photon": "workspace:*",
    "@gravito/prism": "workspace:*",
    "@inertiajs/react": "^1.0.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.4.2",
    "clsx": "^2.1.1",
    "framer-motion": "^12.23.26",
    "js-base64": "^3.7.8",
    "lucide-react": "^0.562.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^2.5.2",
    "three": "^0.182.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/vite": "^4.1.18",
    "@types/node": "^20.11.0",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "autoprefixer": "^10.4.23",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.1.18",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
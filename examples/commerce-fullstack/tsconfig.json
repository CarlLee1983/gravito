{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "types": ["bun-types", "node"],
    "baseUrl": ".",
    "paths": {
      "@gravito/core": ["../../packages/core/src/index.ts"],
      "@gravito/monolith": ["../../packages/monolith/src/index.ts"],
      "@gravito/admin-shell-react": ["../../packages/admin-shell-react/src/index.ts"],
      "@gravito/admin-ui-analytics": ["../../packages/admin-ui-analytics/src/index.tsx"],
      "@gravito/admin-ui-announcement": ["../../packages/admin-ui-announcement/src/index.tsx"],
      "@gravito/admin-ui-catalog": ["../../packages/admin-ui-catalog/src/index.tsx"]
    }
  },
  "include": ["src/**/*"]
}
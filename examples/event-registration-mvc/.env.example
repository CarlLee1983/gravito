# Application
APP_NAME="Event Registration System"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:3000
APP_PORT=3000

# Database (SQLite by default)
DB_CONNECTION=sqlite
DB_DATABASE=./database/database.sqlite

# PostgreSQL (uncomment to use)
# DB_CONNECTION=pgsql
# DB_HOST=localhost
# DB_PORT=5432
# DB_DATABASE=event_registration
# DB_USERNAME=postgres
# DB_PASSWORD=password

# Session
SESSION_DRIVER=cookie
SESSION_LIFETIME=120

# Mail
MAIL_MAILER=smtp
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=noreply@event-registration.local
MAIL_FROM_NAME="${APP_NAME}"

# Security
APP_KEY=base64:your-32-character-secret-key-here

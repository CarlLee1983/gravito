{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@gravito/forge": ["../../packages/forge/src/index.ts"],
      "@gravito/stream": ["../../packages/stream/src/index.ts"],
      "@gravito/core": ["../../packages/core/src/index.ts"],
      "@gravito/*": ["../../packages/*/src/index.ts"]
    }
  },
  "include": ["src/**/*"]
}

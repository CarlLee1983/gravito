    "@gravito/sentinel": "workspace:*",
    "@gravito/signal": "workspace:*",
    "@gravito/fortify": "workspace:*",
    "@gravito/stream": "workspace:*",
    "bullmq": "^5.0.0",
    "ioredis": "^5.3.0",

{
  "name": "@gravito/graphql",
  "version": "0.1.0",
  "description": "Zero-config GraphQL Orbit for Gravito, powered by Yoga",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck"
  },
  "dependencies": {
    "graphql": "^16.8.1",
    "graphql-yoga": "^5.1.1"
  },
  "peerDependencies": {
    "@gravito/core": "workspace:*",
    "typescript": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "bun-types": "latest",
    "tsup": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
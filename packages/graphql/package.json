{
  "name": "@gravito/graphql",
  "version": "1.1.0",
  "description": "Zero-config GraphQL Orbit for Gravito, powered by Yoga",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --timeout=10000 && bun scripts/coverage-report.ts",
    "test:ci": "bun test --coverage --coverage-reporter=lcov --timeout=10000 && bun scripts/coverage-report.ts",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:unit": "bun test '**/*.test.ts' '!**/*.integration.test.ts' --timeout=10000",
    "test:integration": "bun test 'integration.test.ts' --timeout=10000"
  },
  "dependencies": {
    "@envelop/depth-limit": "^7.1.0",
    "@envelop/response-cache": "^9.1.0",
    "@graphql-yoga/plugin-apq": "^3.18.0",
    "dataloader": "^2.2.3",
    "graphql": "^16.8.1",
    "graphql-complexity-validation": "^1.0.4",
    "graphql-middleware": "^6.1.35",
    "graphql-ws": "^6.0.6",
    "graphql-yoga": "^5.1.1"
  },
  "peerDependencies": {
    "@gravito/core": "workspace:*",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@gravito/atlas": "workspace:*",
    "@types/node": "^20.11.0",
    "bun-types": "latest",
    "tsup": "^8.0.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  }
}

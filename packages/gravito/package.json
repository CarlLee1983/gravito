{
  "name": "gravito",
  "sideEffects": false,
  "version": "1.0.3",
  "description": "The official CLI for Gravito Galaxy Architecture. Scaffold projects and manage your universe.",
  "bin": {
    "gravito": "bin/gravito.js"
  },
  "type": "module",
  "exports": {
    ".": "./bin/gravito.js"
  },
  "files": [
    "bin",
    "README.md"
  ],
  "scripts": {
    "build": "node --check bin/gravito.js",
    "test": "bun test tests/ --timeout=10000",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@gravito/pulse": "^3.4.2"
  },
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/gravito"
  }
}

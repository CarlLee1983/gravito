{
  "name": "@gravito/photon",
  "version": "1.0.0-beta.1",
  "description": "Gravito Photon HTTP engine (compat wrapper)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./logger": {
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./bun": {
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./jwt": {
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    },
    "./http-exception": {
      "types": "./dist/http-exception.d.ts",
      "default": "./dist/http-exception.js"
    },
    "./router/reg-exp-router": {
      "types": "./dist/router/reg-exp-router.d.ts",
      "default": "./dist/router/reg-exp-router.js"
    },
    "./router/trie-router": {
      "types": "./dist/router/trie-router.d.ts",
      "default": "./dist/router/trie-router.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:unit": "bun test '**/*.test.ts' '!**/*.integration.test.ts' --timeout=10000",
    "test:integration": "bun test 'integration.test.ts' --timeout=10000"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.2.0",
    "cborg": "^4.3.2",
    "hono": "^4.11.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "bun-types": "latest"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/photon"
  }
}

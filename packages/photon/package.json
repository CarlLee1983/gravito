{
  "name": "@gravito/photon",
  "sideEffects": false,
  "version": "1.1.2",
  "description": "Gravito Photon HTTP engine (compat wrapper)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "module": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "README.zh-TW.md"
  ],
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": {
      "bun": "./dist/native.js",
      "types": "./dist/native.d.ts",
      "default": "./dist/native.js"
    },
    "./adapter": {
      "bun": "./dist/adapter/index.js",
      "types": "./dist/adapter/index.d.ts",
      "default": "./dist/adapter/index.js"
    },
    "./client": {
      "bun": "./dist/client.js",
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./logger": {
      "bun": "./dist/logger.js",
      "types": "./dist/logger.d.ts",
      "default": "./dist/logger.js"
    },
    "./bun": {
      "bun": "./dist/bun.js",
      "types": "./dist/bun.d.ts",
      "default": "./dist/bun.js"
    },
    "./jwt": {
      "bun": "./dist/jwt.js",
      "types": "./dist/jwt.d.ts",
      "default": "./dist/jwt.js"
    },
    "./middleware/binary": {
      "bun": "./dist/middleware/binary.js",
      "types": "./dist/middleware/binary.d.ts",
      "default": "./dist/middleware/binary.js"
    },
    "./middleware/htmx": {
      "bun": "./dist/middleware/htmx.js",
      "types": "./dist/middleware/htmx.d.ts",
      "default": "./dist/middleware/htmx.js"
    },
    "./middleware/ratelimit": {
      "bun": "./dist/middleware/ratelimit.js",
      "types": "./dist/middleware/ratelimit.d.ts",
      "default": "./dist/middleware/ratelimit.js"
    },
    "./middleware/ratelimit-redis": {
      "bun": "./dist/middleware/ratelimit-redis.js",
      "types": "./dist/middleware/ratelimit-redis.d.ts",
      "default": "./dist/middleware/ratelimit-redis.js"
    },
    "./middleware/otel": {
      "bun": "./dist/middleware/otel.js",
      "types": "./dist/middleware/otel.d.ts",
      "default": "./dist/middleware/otel.js"
    },
    "./middleware/streaming": {
      "bun": "./dist/middleware/streaming.js",
      "types": "./dist/middleware/streaming.d.ts",
      "default": "./dist/middleware/streaming.js"
    },
    "./middleware/security": {
      "bun": "./dist/middleware/security/index.js",
      "types": "./dist/middleware/security/index.d.ts",
      "default": "./dist/middleware/security/index.js"
    },
    "./middleware/body": {
      "bun": "./dist/middleware/security/body-size-limit.js",
      "types": "./dist/middleware/security/body-size-limit.d.ts",
      "default": "./dist/middleware/security/body-size-limit.js"
    },
    "./middleware/cors": {
      "bun": "./dist/middleware/security/cors.js",
      "types": "./dist/middleware/security/cors.d.ts",
      "default": "./dist/middleware/security/cors.js"
    },
    "./middleware/rate-limit": {
      "bun": "./dist/middleware/ratelimit.js",
      "types": "./dist/middleware/ratelimit.d.ts",
      "default": "./dist/middleware/ratelimit.js"
    },
    "./http-exception": {
      "bun": "./dist/http-exception.js",
      "types": "./dist/http-exception.d.ts",
      "default": "./dist/http-exception.js"
    },
    "./router/reg-exp-router": {
      "bun": "./dist/router/reg-exp-router.js",
      "types": "./dist/router/reg-exp-router.d.ts",
      "default": "./dist/router/reg-exp-router.js"
    },
    "./router/trie-router": {
      "bun": "./dist/router/trie-router.js",
      "types": "./dist/router/trie-router.d.ts",
      "default": "./dist/router/trie-router.js"
    },
    "./adapter/cloudflare": {
      "bun": "./dist/adapter/cloudflare.js",
      "types": "./dist/adapter/cloudflare.d.ts",
      "default": "./dist/adapter/cloudflare.js"
    },
    "./adapter/vercel": {
      "bun": "./dist/adapter/vercel.js",
      "types": "./dist/adapter/vercel.d.ts",
      "default": "./dist/adapter/vercel.js"
    },
    "./adapter/deno": {
      "bun": "./dist/adapter/deno.js",
      "types": "./dist/adapter/deno.d.ts",
      "default": "./dist/adapter/deno.js"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:dts": "bun run build.ts --dts-only",
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:unit": "bun test tests/ --timeout=10000",
    "test:integration": "test $(find tests -name '*.integration.test.ts' 2>/dev/null | wc -l) -gt 0 && find tests -name '*.integration.test.ts' -print0 | xargs -0 bun test --timeout=10000 || echo 'No integration tests found'"
  },
  "dependencies": {
    "@gravito/core": "workspace:*",
    "cborg": "^4.3.2",
    "hono": "^4.12.2",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@hono/zod-openapi": "^1.2.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.0.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "bun-types": "^1.3.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/photon"
  }
}

{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "baseUrl": ".",
    "outDir": "./dist",
    "declaration": true,
    "emitDeclarationOnly": true,
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@gravito/photon": ["./src/index.ts"],
      "@gravito/photon/*": ["./src/*"],
      "hono/*": ["../../node_modules/hono/dist/types/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}

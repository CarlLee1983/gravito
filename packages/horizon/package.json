{
  "name": "@gravito/horizon",
  "version": "3.0.0",
  "description": "Distributed task scheduler for Gravito framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "lint": "biome lint ./src",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:coverage": "bun test --coverage --coverage-threshold=60",
    "test:ci": "bun test --coverage --coverage-threshold=60"
  },
  "keywords": [
    "gravito",
    "orbit",
    "scheduler",
    "cron",
    "task"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "dependencies": {},
  "optionalDependencies": {
    "cron-parser": "^4.9.0"
  },
  "peerDependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/stasis": "workspace:*"
  },
  "devDependencies": {
    "@gravito/stasis": "workspace:*",
    "bun-types": "latest",
    "@gravito/core": "workspace:*",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/horizon"
  }
}
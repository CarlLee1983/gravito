{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "skipLibCheck": true,
    "types": ["bun-types"],
    "baseUrl": ".",
    "paths": {
      "@gravito/nova": ["../nova/src/index.ts"],
      "@gravito/ripple": ["../ripple/src/index.ts"],
      "@gravito/stasis": ["../stasis/src/index.ts"],
      "@gravito/plasma": ["../plasma/src/index.ts"],
      "@gravito/core": ["../core/dist/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "**/*.test.ts"]
}

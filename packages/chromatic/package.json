{
  "name": "@gravito/chromatic",
  "version": "1.0.1",
  "description": "Color manipulation, styling and theming system for Gravito",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:dts": "bun run build.ts --dts-only",
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage",
    "lint": "biome lint ./src",
    "lint:fix": "biome lint --write ./src",
    "format": "biome format --write ./src",
    "format:check": "biome format ./src",
    "check": "biome check ./src",
    "check:fix": "biome check --write ./src",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "prepublishOnly": "bun run typecheck && bun run build"
  },
  "keywords": [
    "color",
    "terminal",
    "styling",
    "theme",
    "gravito"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/chromatic"
  },
  "bugs": {
    "url": "https://github.com/gravito-framework/gravito/issues"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "engines": {
    "node": ">=18.0.0",
    "bun": ">=1.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@gravito/core": "workspace:*"
  }
}

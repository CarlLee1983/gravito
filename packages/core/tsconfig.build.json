{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@gravito/core": ["./src/index.ts"],
      "@gravito/core/compat": ["./src/compat.ts"],
      "@gravito/core/engine": ["./src/engine/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}

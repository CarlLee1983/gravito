{
  "name": "@gravito/core",
  "version": "2.0.1",
  "description": "",
  "module": "./dist/index.js",
  "main": "./dist/index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "browser": "./src/index.browser.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.cjs"
    },
    "./compat": {
      "types": "./dist/compat.d.ts",
      "import": "./dist/compat.js",
      "require": "./dist/compat.cjs",
      "default": "./dist/compat.cjs"
    },
    "./engine": {
      "types": "./dist/engine/index.d.ts",
      "import": "./dist/engine/index.js",
      "require": "./dist/engine/index.cjs",
      "default": "./dist/engine/index.cjs"
    },
    "./ffi": {
      "types": "./dist/ffi/index.d.ts",
      "import": "./dist/ffi/index.js",
      "require": "./dist/ffi/index.cjs",
      "default": "./dist/ffi/index.cjs"
    },
    "./compat/async-local-storage": {
      "browser": "./src/compat/async-local-storage.browser.ts",
      "default": "./src/compat/async-local-storage.ts"
    },
    "./compat/crypto": {
      "browser": "./src/compat/crypto.browser.ts",
      "default": "./src/compat/crypto.ts"
    }
  },
  "files": [
    "dist",
    "src/ffi/native",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "build:dts": "bun run build.ts --dts-only",
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "benchmark:event-system": "bun run benchmarks/event-system.bench.ts",
    "lint": "biome lint ./src ./tests",
    "lint:fix": "biome lint --write ./src ./tests",
    "format": "biome format --write ./src ./tests",
    "format:check": "biome format ./src ./tests",
    "check": "biome check ./src ./tests",
    "check:fix": "biome check --write ./src ./tests",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build",
    "test:unit": "bun test $(find tests -name '*.test.ts' ! -name '*.integration.test.ts' 2>/dev/null | tr '\\n' ' ') --timeout=10000",
    "test:integration": "test $(find tests -name '*.integration.test.ts' 2>/dev/null | wc -l) -gt 0 && find tests -name '*.integration.test.ts' -print0 | xargs -0 bun test --timeout=10000 || echo 'No integration tests found'"
  },
  "keywords": [],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/gravito-framework/gravito/issues"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "mitata": "^1.0.34",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "zod": "^4.3.6"
  }
}

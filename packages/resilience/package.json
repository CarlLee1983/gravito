{
  "name": "@gravito/resilience",
  "version": "1.0.1",
  "description": "Event system resilience layer for Gravito (Circuit Breaker, DLQ, Backpressure, Worker Pool)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "bun": "./dist/index.js",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "peerDependencies": {
    "@gravito/core": "^2.0.0",
    "@opentelemetry/api": "^1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentelemetry/api": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/photon": "workspace:*",
    "@opentelemetry/api": "^1.9.0",
    "bun-types": "latest",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "scripts": {
    "build": "bun run build.ts",
    "build:dts": "bun run build.ts --dts-only",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test": "bun test tests/ --timeout=10000"
  },
  "files": [
    "dist",
    "README.md"
  ]
}

{
  "name": "@gravito/stream",
  "version": "2.0.1",
  "publishConfig": {
    "access": "public"
  },
  "description": "Lightweight, high-performance queue system for Gravito framework. Supports multiple brokers (Database, Redis, Kafka, SQS) with zero runtime overhead.",
  "module": "./dist/index.js",
  "main": "./dist/index.cjs",
  "type": "module",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "proto",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:coverage": "bun test --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts"
  },
  "keywords": [
    "gravito",
    "orbit",
    "queue",
    "job",
    "worker",
    "kafka",
    "sqs",
    "redis"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.955.0",
    "@gravito/atlas": "workspace:*",
    "@gravito/core": "workspace:*",
    "@grpc/grpc-js": "^1.14.3",
    "@grpc/proto-loader": "^0.8.0",
    "cron-parser": "^5.4.0",
    "p-limit": "^5.0.0"
  },
  "devDependencies": {
    "@types/ioredis": "^5.0.0",
    "bun-types": "latest",
    "ioredis": "^5.9.2",
    "mitata": "^1.0.34",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/stream"
  }
}

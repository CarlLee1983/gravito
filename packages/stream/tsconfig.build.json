{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "skipLibCheck": true,
    "noCheck": true,
    "types": ["bun-types"],
    "paths": {
      "@gravito/stream": ["./src/index.ts"],
      "@gravito/core": ["../core/src/index.ts"],
      "@gravito/atlas": ["../atlas/src/index.ts"],
      "@gravito/*": ["../*/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "tests", "**/*.test.ts"]
}

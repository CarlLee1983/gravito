{
  "name": "@gravito/ripple",
  "version": "4.0.0-alpha.1",
  "description": "Bun-native WebSocket broadcasting for Gravito. Channel-based real-time communication.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:coverage": "bun test --coverage --coverage-threshold=60",
    "test:ci": "bun test --coverage --coverage-threshold=60",
    "bench": "bun run benchmarks/index.ts"
  },
  "keywords": [
    "gravito",
    "websocket",
    "bun",
    "realtime",
    "broadcasting",
    "channels"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/ripple"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "peerDependencies": {
    "@gravito/core": "workspace:*",
    "ioredis": "^5.0.0",
    "nats": "^2.23.0"
  },
  "peerDependenciesMeta": {
    "ioredis": {
      "optional": true
    },
    "nats": {
      "optional": true
    }
  },
  "devDependencies": {
    "bun-types": "latest",
    "ioredis": "^5.4.2",
    "tinybench": "^6.0.0",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "protobufjs": "^8.0.0"
  }
}

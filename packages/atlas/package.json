{
  "name": "@gravito/atlas",
  "version": "1.5.0",
  "description": "The Standard Database Orbit - Custom Query Builder & ORM for Gravito",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "orbit": "src/cli.ts"
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --timeout=10000 --max-concurrency=${TEST_CONCURRENCY:-2}",
    "test:coverage": "bun test --timeout=10000 --max-concurrency=${TEST_CONCURRENCY:-2} --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --max-concurrency=${TEST_CONCURRENCY:-2} --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "docs:generate": "typedoc --out docs/api src/index.ts"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "keywords": [
    "gravito",
    "database",
    "query-builder",
    "orm",
    "postgresql",
    "mysql",
    "mariadb",
    "sqlite"
  ],
  "author": "Gravito Team",
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/semantic-conventions": "^1.39.0",
    "lru-cache": "^11.0.2"
  },
  "peerDependencies": {
    "better-sqlite3": "^11.0.0",
    "ioredis": "^5.8.2",
    "mongodb": "^6.0.0",
    "mysql2": "^3.9.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "ioredis": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "mysql2": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@swc/core": "^1.15.8",
    "@types/better-sqlite3": "^7.6.0",
    "@types/ioredis": "^5.0.0",
    "@types/node": "^20.0.0",
    "@types/pg": "^8.11.0",
    "better-sqlite3": "^11.0.0",
    "bun-types": "latest",
    "ioredis": "^5.8.2",
    "mongodb": "^6.0.0",
    "mysql2": "^3.9.0",
    "pg": "^8.11.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "mitata": "^1.0.34",
    "typedoc": "^0.27.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/atlas"
  }
}

{
  "name": "@gravito/cosmos",
  "version": "3.1.0",
  "description": "Internationalization orbit for Gravito framework",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test",
    "test:coverage": "bun test --coverage --coverage-threshold=50",
    "test:ci": "bun test --coverage --coverage-threshold=50",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck"
  },
  "keywords": [
    "gravito",
    "orbit",
    "i18n",
    "internationalization"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/photon": "workspace:*"
  },
  "devDependencies": {
    "bun-types": "latest",
    "mitata": "^1.0.34",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/cosmos"
  },
  "dependencies": {
    "lru-cache": "^11.2.5"
  }
}

{
  "name": "@gravito/quasar",
  "version": "1.3.0",
  "description": "Universal monitoring agent for Gravito Zenith with queue statistics (Probes) and real-time job tracking (Bridges)",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "test": "bun test --timeout=10000",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "docs": "typedoc",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:unit": "bun test '**/*.test.ts' '!**/*.integration.test.ts' --timeout=10000",
    "test:integration": "bun test '**/*.integration.test.ts' --timeout=10000"
  },
  "keywords": [
    "monitoring",
    "queue",
    "bullmq",
    "bee-queue",
    "redis",
    "metrics",
    "observability",
    "zenith",
    "gravito"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/gravito-framework/gravito-core",
    "directory": "packages/quasar"
  },
  "license": "MIT",
  "files": [
    "src",
    "README.md",
    "CHANGELOG.md",
    "BRIDGES.md"
  ],
  "dependencies": {
    "@opentelemetry/api": "^1.9.0",
    "cborg": "^4.5.8",
    "ioredis": "^5.4.2",
    "msgpackr": "^1.11.8",
    "protobufjs": "^8.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@aws-sdk/client-sqs": "^3.975.0",
    "@types/node": "^20.10.0",
    "@types/protobufjs": "^6.0.0",
    "@types/ws": "^8.5.10",
    "bun-types": "latest",
    "typedoc": "^0.25.0",
    "typedoc-plugin-markdown": "^3.16.0",
    "vitest": "^4.0.18"
  },
  "peerDependencies": {
    "bullmq": ">=5.0.0",
    "bee-queue": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    },
    "bee-queue": {
      "optional": true
    }
  }
}

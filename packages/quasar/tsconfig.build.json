{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": true,
    "emitDeclarationOnly": true,
    "paths": {
      "@gravito/core": ["../core/dist/index.d.ts"],
      "@gravito/core/*": ["../core/dist/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["src/__tests__/**/*", "node_modules", "dist"]
}

{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "baseUrl": ".",
    "declaration": true,
    "emitDeclarationOnly": false,
    "composite": true,
    "skipLibCheck": true,
    "types": ["node", "bun-types"],
    "paths": {
      "@gravito/core": ["../core/src/index.ts"],
      "@gravito/*": ["../*/src/index.ts"]
    }
  },
  "include": ["src/**/*", "tests/**/*"],
  "exclude": ["node_modules", "dist"]
}

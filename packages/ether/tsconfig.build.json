{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationMap": false,
    "outDir": "./dist",
    "rootDir": "src",
    "skipLibCheck": true,
    "baseUrl": ".",
    "types": [
      "bun-types"
    ],
    "paths": {
      "@gravito/ether": [
        "./src/index.ts"
      ],
      "@gravito/core": [
        "../../packages/core/dist/index.d.ts"
      ],
      "@gravito/core/*": [
        "../../packages/core/dist/*"
      ],
      "@gravito/*": [
        "../../packages/*/dist/index.d.ts"
      ]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "tests",
    "**/*.test.ts",
    "**/*.test.tsx"
  ]
}
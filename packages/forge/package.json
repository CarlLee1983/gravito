{
  "name": "@gravito/forge",
  "version": "3.0.3",
  "publishConfig": {
    "access": "public"
  },
  "description": "File Processing Orbit for Gravito - Video and Image Processing with Real-time Status Tracking",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./vue": {
      "types": "./dist/vue/index.d.ts",
      "import": "./dist/vue/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun run build.ts",
    "test": "bun test --timeout=10000",
    "typecheck": "bun tsc -p tsconfig.json --noEmit --skipLibCheck",
    "test:coverage": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:ci": "bun test --timeout=10000 --coverage --coverage-reporter=lcov --coverage-dir coverage && bun run --bun scripts/check-coverage.ts",
    "test:unit": "bun test $(find tests -name '*.test.ts' ! -name '*.integration.test.ts' 2>/dev/null | tr '\\n' ' ') --timeout=10000",
    "test:integration": "test $(find tests -name '*.integration.test.ts' 2>/dev/null | wc -l) -gt 0 && find tests -name '*.integration.test.ts' -print0 | xargs -0 bun test --timeout=10000 || echo 'No integration tests found'"
  },
  "keywords": [
    "gravito",
    "orbit",
    "file-processing",
    "video",
    "image",
    "ffmpeg",
    "imagemagick",
    "sse",
    "real-time"
  ],
  "author": "Carl Lee <carllee0520@gmail.com>",
  "license": "MIT",
  "peerDependencies": {
    "@gravito/core": "^1.6.1",
    "@gravito/nebula": "^4.1.1",
    "@gravito/stream": "^2.0.2"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "vue": {
      "optional": true
    },
    "@gravito/nebula": {
      "optional": true
    },
    "@gravito/stream": {
      "optional": true
    }
  },
  "devDependencies": {
    "@gravito/nebula": "^4.1.1",
    "@gravito/stream": "^2.0.2",
    "@types/react": "^18.0.0",
    "bun-types": "latest",
    "@gravito/core": "^1.6.1",
    "@gravito/photon": "^1.0.1",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vue": "^3.5.26"
  },
  "homepage": "https://github.com/gravito-framework/gravito#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gravito-framework/gravito.git",
    "directory": "packages/forge"
  },
  "dependencies": {
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2"
  }
}

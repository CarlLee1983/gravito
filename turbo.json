{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**/*.test.ts", "!tests/**/*.integration.test.ts", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**/*.integration.test.ts", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": [],
      "cache": false
    },
    "test:ci": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "package.json", "biome.json"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}

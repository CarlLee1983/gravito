{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "biome.json"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "static/**"]
    },
    "create-gravito-app#build": {
      "cache": false,
      "outputs": [],
      "dependsOn": []
    },
    "my-gravito-app#build": {
      "cache": true,
      "outputs": ["dist/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "biome.json"],
      "dependsOn": ["^build"]
    },
    "my-gravito-inertia-app#build": {
      "cache": true,
      "outputs": ["dist/**", "static/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts", "biome.json"],
      "dependsOn": ["^build"]
    },
    "my-gravito-inertia-vue-app#build": {
      "cache": true,
      "outputs": ["dist/**", "static/**"],
      "inputs": ["src/**", "package.json", "tsconfig.json", "vite.config.ts", "biome.json"],
      "dependsOn": ["^build"]
    },
    "my-gravito-static-site#build": {
      "cache": true,
      "outputs": ["dist/**", "dist-static/**"],
      "inputs": [
        "src/**",
        "package.json",
        "tsconfig.json",
        "vite.config.ts",
        "build-static.ts",
        "biome.json"
      ],
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "test:unit": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": [],
      "cache": true
    },
    "test:integration": {
      "dependsOn": [],
      "inputs": [
        "src/**",
        "tests/**/*.integration.test.ts",
        "package.json",
        "tsconfig.json",
        "bunfig.toml"
      ],
      "outputs": [],
      "cache": true
    },
    "test:ci": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "test:coverage": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "lint": {
      "inputs": ["src/**", "tests/**", "package.json", "biome.json"],
      "outputs": [],
      "cache": true
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "example-banking-cqrs#typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json"],
      "outputs": []
    },
    "example-banking-cqrs#test": {
      "dependsOn": [],
      "inputs": ["src/**", "tests/**", "package.json", "tsconfig.json", "bunfig.toml"],
      "outputs": []
    }
  }
}

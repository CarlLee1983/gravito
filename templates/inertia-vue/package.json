{
  "name": "my-gravito-inertia-vue-app",
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "vue-tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/beam": "workspace:*",
    "@gravito/stasis": "workspace:*",
    "@gravito/prism": "workspace:*",
    "@gravito/photon": "workspace:*",
    "@gravito/ion": "workspace:*",
    "@gravito/sentinel": "workspace:*",
    "@gravito/mass": "workspace:*",
    "@inertiajs/vue3": "^2.0.0",
    "vue": "^3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@vitejs/plugin-vue": "^5.0.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vue-tsc": "^2.0.0"
  }
}

{
  "name": "my-gravito-static-site",
  "version": "0.1.6",
  "type": "module",
  "scripts": {
    "dev": "bun run dev:vite & bun run dev:server",
    "dev:server": "NODE_ENV=development bun run --watch src/index.ts",
    "dev:vite": "vite",
    "build:client": "vite build",
    "build:static": "NODE_ENV=production bun build-static.ts",
    "build": "bun run build:client && bun run build:static",
    "preview:static": "cd dist-static && npx serve .",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "typecheck": "bun tsc --noEmit",
    "start": "bun run src/index.ts",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/stasis": "workspace:*",
    "@gravito/prism": "workspace:*",
    "@gravito/ion": "workspace:*",
    "@gravito/constellation": "workspace:*",
    "@inertiajs/react": "^1.0.0",
    "@inertiajs/vue3": "^1.0.0",
    "@inertiajs/svelte": "^1.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "vue": "^3.4.0",
    "svelte": "^5.0.0",
    "@gravito/photon": "workspace:*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitejs/plugin-vue": "^5.0.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte-check": "^3.6.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "^3.0.0",
    "@vitest/ui": "^3.0.0",
    "@testing-library/svelte": "^5.3.0",
    "@testing-library/jest-dom": "^6.6.3",
    "jsdom": "^25.0.0"
  }
}

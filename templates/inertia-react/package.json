{
  "name": "my-gravito-inertia-app",
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun run build:client && bun run build:server",
    "build:client": "vite build",
    "build:server": "bun build ./src/index.ts --outdir ./dist --target bun",
    "start": "bun run src/index.ts",
    "typecheck": "bun tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "dependencies": {
    "@gravito/core": "workspace:*",
    "@gravito/beam": "workspace:*",
    "@gravito/stasis": "workspace:*",
    "@gravito/prism": "workspace:*",
    "@gravito/ion": "workspace:*",
    "@gravito/sentinel": "workspace:*",
    "@gravito/mass": "workspace:*",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.2.0",
    "bun-types": "latest",
    "typescript": "^5.9.3",
    "vite": "^6.4.1"
  }
}
